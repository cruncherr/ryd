# ─────────────────────────────────────────────────────────────────────────────
#  Ustawienia sklepu poza panelem (tzw. zmienne środowiskowe).
#  Na hostingu wpisuje się je w ustawieniach projektu; do pracy na własnym
#  komputerze skopiuj ten plik jako ".env" i uzupełnij wartości.
#  Pliku ".env" nigdy nie wysyłaj do repozytorium — zawiera hasła.
# ─────────────────────────────────────────────────────────────────────────────

# ── WYMAGANE ─────────────────────────────────────────────────────────────────

# Adres bazy danych PostgreSQL. Na Vercelu ustawia się sam po podłączeniu bazy Neon
# (sklep rozumie też nazwy DATABASE_URL i POSTGRES_URL).
DATABASE_URI=postgres://uzytkownik:haslo@127.0.0.1:5432/ryd

# Tajny klucz panelu: dowolny losowy ciąg, co najmniej 32 znaki. Nie zmieniaj go później —
# po zmianie wszyscy zalogowani zostaną wylogowani.
# Wygenerujesz go np. poleceniem:  openssl rand -hex 32
PAYLOAD_SECRET=

# ── ZALECANE PRZY PIERWSZYM URUCHOMIENIU ─────────────────────────────────────

# Pierwsze konto administratora. Sklep założy je sam przy wdrożeniu (tylko gdy w panelu
# nie ma jeszcze żadnego konta). Po pierwszym logowaniu zmień hasło w panelu
# i usuń ADMIN_PASSWORD z ustawień hostingu.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Publiczny adres sklepu (bez ukośnika na końcu). Na Vercelu ustawia się sam;
# podaj go ręcznie przy innym hostingu albo gdy adres w e-mailach jest nieprawidłowy.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── POCZTA (bez niej klienci nie dostaną potwierdzeń zamówień) ───────────────

# Dane skrzynki, z której sklep wysyła wiadomości — podaje je dostawca poczty
# (np. home.pl, OVH, Google Workspace, Zoho) w sekcji „konfiguracja programu pocztowego / SMTP”.
SMTP_HOST=
# 587 (najczęściej) albo 465
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adres nadawcy — musi należeć do tej skrzynki, np. sklep@twojadomena.pl
SMTP_FROM=
# Nazwa nadawcy widoczna u klienta, gdy w panelu nie podano nazwy sklepu
SMTP_FROM_NAME=

# ── ZDJĘCIA NA VERCELU ───────────────────────────────────────────────────────

# Ustawia się sam po podłączeniu magazynu „Blob” w projekcie Vercel.
# Bez niego (np. na własnym serwerze) zdjęcia zapisują się w katalogu /media.
BLOB_READ_WRITE_TOKEN=

# ── PŁATNOŚCI ONLINE (opcjonalnie) ───────────────────────────────────────────

# Klucze z panelu Stripe. Dopóki ich nie ma, sklep działa z przelewem tradycyjnym
# i płatnością przy odbiorze, a opcja „Płatność online” nie pojawia się w zamówieniu.
STRIPE_SECRET_KEY=
# Sekret podpisu powiadomień dla adresu  https://twojadomena.pl/platnosc/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── DLA PROGRAMISTY (opcjonalnie) ────────────────────────────────────────────

# Dodatkowe adresy, z których wolno wysyłać formularze sklepu (koszyk, zamówienie, kontakt), oddzielone
# przecinkami — potrzebne tylko za serwerem pośredniczącym, który nie przekazuje publicznego adresu
# (np. tunel albo podgląd). Przykład: sklep.pl,*.sklep.pl
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Katalog, do którego sklep dodatkowo zapisuje każdą wysłaną wiadomość jako plik HTML.
EMAIL_PREVIEW_DIR=
# Adres sklepu, na którym mają się uruchomić testy przeglądarkowe (pnpm test:e2e).
E2E_BASE_URL=http://localhost:3000
